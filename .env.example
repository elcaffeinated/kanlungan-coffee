# Copy to .env (never commit your real .env)

# Contact + order forms are emailed to you via Formspree (https://formspree.io).
# Create a free form there and paste its ID (the part after /f/ in the endpoint URL).
VITE_FORMSPREE_ID=

# Leave false for static hosting (GitHub Pages / Netlify / Vercel).
# Set true only when running the Node backend in /server (npm start).
VITE_USE_BACKEND=false
